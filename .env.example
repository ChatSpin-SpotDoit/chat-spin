# ─── Environment Configuration ────────────────────────────────────────────────
NODE_ENV=development

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────────────
DATABASE_URL=postgres://chatspin:chatspin_dev_pass@localhost:5432/chatspin_db

# ─── Redis (v7) ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (NextAuth.js v5 + Google OAuth) ────────────────────────────────────
NEXTAUTH_SECRET=chatspin_dev_secret_at_least_32_characters_long_for_security
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret

# ─── TURN Server (coturn) ────────────────────────────────────────────────────
TURN_ENABLED=false
COTURN_HOST=localhost
COTURN_PORT=3478
COTURN_TLS_PORT=5349
COTURN_SECRET=chatspin_coturn_dev_secret
TURN_CREDENTIAL_TTL=3600

# ─── Feature Thresholds ──────────────────────────────────────────────────────
AUTO_FRIEND_THRESHOLD_SECONDS=300
FRIEND_CALL_RING_TIMEOUT_SECONDS=45
CHAT_RETENTION_DAYS=7
DM_RETENTION_DAYS=90
FRIEND_REQUEST_EXPIRY_DAYS=7

# ─── Session & Matchmaking ────────────────────────────────────────────────────
SESSION_HEARTBEAT_TIMEOUT_MS=30000
SESSION_RECONNECT_WINDOW_MS=10000
MATCHMAKING_POLL_INTERVAL_MS=500
MATCH_FOUND_TIMEOUT_MS=10000
STALE_QUEUE_MAX_AGE_MS=300000

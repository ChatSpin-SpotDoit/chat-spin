{
  "name": "@chatspin/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "db:push": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs push",
    "test": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@chatspin/config": "workspace:*",
    "@chatspin/protocol": "workspace:*",
    "@chatspin/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/websocket": "^11.0.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.28.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
